<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================== -->
    <!-- TREE VIEW (CONTACTOS) -->
    <!-- ===================== -->
    <record id="view_partner_tree_activity_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.activity.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_list"/>
        <field name="arch" type="xml">

            <!-- XPath robusto: evita depender de campos como email -->
            <xpath expr="//list" position="inside">
                <field name="activity_followup_count" string="Seguimientos"/>
            </xpath>

        </field>
    </record>


    <!-- ===================== -->
    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_partner_form_activity_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.activity.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Lo añadimos dentro del sheet para asegurar compatibilidad -->
            <xpath expr="//sheet" position="inside">
                <group string="Actividad comercial">
                    <field name="activity_followup_count" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>